# PostgreSQL & Redis
DATABASE_URL=sqlite:///./instantly.db
POSTGRES_USER=instantly
POSTGRES_PASSWORD=instantly_secret
POSTGRES_DB=instantly
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379/0

# Security & Authentication
SECRET_KEY=change-this-to-a-secure-random-64-char-hex-string-in-production
TOKEN_ENCRYPTION_KEY=change-this-to-a-32-byte-base64-fernet-key-in-production
ENCRYPTION_KEY=change-this-to-a-32-byte-base64-fernet-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DEMO_MODE=true

# AI Provider Configuration (openai | groq | heuristic)
AI_PROVIDER=heuristic
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=gsk-your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Gmail OAuth 2.0 Integration
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/gmail/callback

# Slack OAuth 2.0 Integration
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_REDIRECT_URI=http://localhost:8000/api/v1/integrations/slack/callback
SLACK_BOT_TOKEN=xoxb-your-optional-direct-bot-token

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=Instantly

